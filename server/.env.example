# Documentation only: supply these through your host's environment or secret manager.
APP_ENV=production
FIREBASE_PROJECT_ID=your-firebase-project-id
PORT=8080
# Comma-separated exact HTTPS origins. Leave empty for native-only clients.
ALLOWED_ORIGINS=
# On Cloud Run use an attached service identity and Application Default Credentials.
# For local trusted-operator work only, point GOOGLE_APPLICATION_CREDENTIALS at an
# untracked service-account file outside this repository. Never bundle it in the app.
